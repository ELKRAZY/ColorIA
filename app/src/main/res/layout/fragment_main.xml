<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/backgroundColor"
    tools:context=".fragments.MainFragment">

    <!-- Header Section -->
    <View
        android:id="@+id/headerBackground"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@color/primaryBrand"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textViewPerfil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/roboto_bold"
        android:text="@string/perfil"
        android:textColor="@color/white"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Profile Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/profileCard"
        style="@style/ProfileCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/textViewPerfil">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.cardview.widget.CardView
                android:id="@+id/imageContainer"
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:cardCornerRadius="40dp"
                app:cardElevation="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/imageViewPfp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/vincent"
                    android:importantForAccessibility="no" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/textViewName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/roboto_bold"
                android:text="@string/name"
                android:textColor="@color/textPrimary"
                android:textSize="18sp"
                app:layout_constraintBottom_toTopOf="@id/textViewEmail"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/imageContainer"
                app:layout_constraintTop_toTopOf="@id/imageContainer"
                app:layout_constraintVertical_chainStyle="packed" />

            <TextView
                android:id="@+id/textViewEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="@font/roboto_regular"
                android:text="@string/email"
                android:textColor="@color/textSecondary"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="@id/imageContainer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/imageContainer"
                app:layout_constraintTop_toBottomOf="@id/textViewName" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Settings Section -->
    <TextView
        android:id="@+id/textViewAjustes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:fontFamily="@font/roboto_bold"
        android:text="@string/ajustes"
        android:textColor="@color/textPrimary"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profileCard" />

    <LinearLayout
        android:id="@+id/settingsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_rounded_surface"
        android:orientation="vertical"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/textViewAjustes">

        <!-- Information -->
        <LinearLayout
            android:id="@+id/buttonInformacion"
            style="@style/MenuItemContainer">
            <ImageView style="@style/MenuItemIcon" android:src="@drawable/user_person" />
            <TextView style="@style/MenuItemText" android:text="@string/informacion" />
            <ImageView style="@style/MenuItemIcon" android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

        <!-- Password -->
        <LinearLayout
            android:id="@+id/buttonPass"
            style="@style/MenuItemContainer">
            <ImageView style="@style/MenuItemIcon" android:src="@drawable/key_pass" />
            <TextView style="@style/MenuItemText" android:text="@string/contrase_a" />
            <ImageView style="@style/MenuItemIcon" android:src="@drawable/ic_chevron_right" />
        </LinearLayout>
    </LinearLayout>

    <!-- More Info Section -->
    <TextView
        android:id="@+id/textViewMoreInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/roboto_bold"
        android:text="@string/m_s_informaci_n"
        android:textColor="@color/textPrimary"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/settingsContainer" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_rounded_surface"
        android:orientation="vertical"
        android:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/textViewMoreInfo">

        <!-- Version -->
        <LinearLayout
            android:id="@+id/buttonVersion"
            style="@style/MenuItemContainer">
            <ImageView style="@style/MenuItemIcon" android:src="@drawable/ic_outline_info_24" />
            <TextView style="@style/MenuItemText" android:text="@string/versi_n_de_la_app" />
            <ImageView style="@style/MenuItemIcon" android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

        <!-- FAQ -->
        <LinearLayout
            android:id="@+id/buttonQuestion"
            style="@style/MenuItemContainer">
            <ImageView style="@style/MenuItemIcon" android:src="@drawable/ic_baseline_help_outline_24" />
            <TextView style="@style/MenuItemText" android:text="@string/preguntas_frecuentes" />
            <ImageView style="@style/MenuItemIcon" android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

        <!-- Logout -->
        <LinearLayout
            android:id="@+id/buttonLogOut"
            style="@style/MenuItemContainer">
            <ImageView style="@style/MenuItemIcon" android:src="@drawable/ic_baseline_exit_to_app_24" android:tint="@color/accent" />
            <TextView style="@style/MenuItemText" android:text="@string/cerrar_sesi_n" android:textColor="@color/accent" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>