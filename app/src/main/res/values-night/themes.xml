<resources>
    <!-- Night theme (Dark/Monokai) - This is the default -->
    <style name="Theme.ColorIA" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primaryBrand</item>
        <item name="colorPrimaryVariant">@color/primaryVariant</item>
        <item name="colorOnPrimary">@color/textOnPrimary</item>
        
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondaryBrand</item>
        <item name="colorSecondaryVariant">@color/secondaryBrand</item>
        <item name="colorOnSecondary">@color/white</item>
        
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/backgroundMain</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Backgrounds -->
        <item name="android:windowBackground">@color/backgroundMain</item>
        <item name="backgroundColor">@color/backgroundMain</item>
        
        <!-- Text -->
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
    </style>

    <style name="BottomNav">
        <item name="android:background">@color/surfaceCard</item>
        <item name="itemIconTint">@color/textSecondary</item>
        <item name="itemTextColor">@color/textSecondary</item>
        <item name="android:elevation">8dp</item>
    </style>

    <style name="ProfileCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surfaceCard</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <style name="MenuItemContainer">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:padding">16dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="MenuItemText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:fontFamily">@font/roboto_medium</item>
        <item name="android:layout_marginStart">16dp</item>
    </style>

    <style name="MenuItemIcon">
        <item name="android:layout_width">24dp</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:tint">@color/textSecondary</item>
    </style>
</resources>
